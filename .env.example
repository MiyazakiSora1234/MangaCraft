# ============================================================
#  文章生成（Ollama）
# ============================================================
# OLLAMA_URL=http://localhost:11434
# 日本語が得意なモデル推奨（例: gemma3:12b, qwen3:14b, gemma3:27b）
OLLAMA_MODEL=gemma3:12b
# 成人向け（R18）の作品だけで使うモデル（ご自身で ollama pull しておく）
OLLAMA_ADULT_MODEL=dolphin-mistral
# コンテキスト長（ページ数が多いときは大きめに）
# OLLAMA_NUM_CTX=16384

# ============================================================
#  画像生成（同梱の image-server/）
# ============================================================
# DIFFUSERS_URL=http://localhost:7861
# Hugging Face の SDXL モデル（Diffusers 形式）
# DIFFUSERS_MODEL=cagliostrolab/animagine-xl-4.0
# VRAM が足りないときは model（生成は遅くなる）
# DIFFUSERS_OFFLOAD=none
# IMAGE_SERVER_PORT=7861

# ============================================================
#  その他
# ============================================================
# PORT=3000
# MAX_PAGES=20
