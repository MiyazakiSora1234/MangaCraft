{
  "name": "mangacraft",
  "version": "1.0.0",
  "description": "ストーリーの概要から漫画を生成するWebアプリ",
  "main": "src/server/index.ts",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && node --env-file-if-exists=.env src/server/index.ts",
    "local": "npm run build && node scripts/run.mjs local",
    "dev": "node scripts/run.mjs dev",
    "mock": "npm run build && node --env-file-if-exists=.env src/server/index.ts --mock",
    "image-server": "cd image-server && uv run server.py",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
